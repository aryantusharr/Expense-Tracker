rules_version = '2';
// TEST project only (splitease-test-2026). Open read/write to mirror the app,
// which has no sign-in. Expires so the test database can't stay open forever.
// Deploy: firebase deploy --config firebase.test.json --only firestore:rules --project test
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2027, 1, 1);
    }
  }
}
